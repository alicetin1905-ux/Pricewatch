# Copy to .env and edit. Without SERPAPI_KEY the app shows simulated demo prices.
SERPAPI_KEY=

# Only needed to open the dashboard from other devices (set HOST=0.0.0.0).
# HOST=0.0.0.0
# AUTH_PASSWORD=choose-a-long-password

# SerpAPI free plan: 250 searches a month. Set the day of the month it renews.
# SERPAPI_MONTHLY_LIMIT=250
# SERPAPI_RESET_DAY=1

# PORT=3737
# REFRESH_MINUTES=      # leave unset to pace refreshes to the search budget
